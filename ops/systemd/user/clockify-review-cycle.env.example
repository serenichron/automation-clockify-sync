# Install as %h/.config/serenichron/clockify-review-cycle.env with mode 0600.
# Credentials stay in the existing mode-0600 precision-inference-client.env
# and %h/.config/gws. Do not copy either into this file or the release tree.
CLOCKIFY_ANALYZER_PRIMARY_URL=https://precision-llm.serenichron.agency/v1/chat/completions
CLOCKIFY_ANALYZER_PRIMARY_MODEL=deepseek-v4-flash:cloud
CLOCKIFY_ANALYZER_PRIMARY_REVISION=REPLACE_WITH_64_HEX_REVISION
CLOCKIFY_ANALYZER_PRIMARY_REASONING_EFFORT=none
CLOCKIFY_ANALYZER_PRIMARY_TIMEOUT_SECONDS=600
CLOCKIFY_HTTP_TIMEOUT_SECONDS=30
CLOCKIFY_ANALYZER_PRIVATE_TEXT_APPROVED=approved
# Collector checkpoints default to the canonical config state_dir at
# state_dir/collector-checkpoints. An explicit override is optional and must
# be an absolute canonical path contained within that same state_dir. An
# existing root must be current-user-owned with exact mode 0700. If an explicit
# override target is absent, its immediate parent must already exist with those
# same ownership and mode guarantees.
# CLOCKIFY_COLLECTOR_CHECKPOINT_ROOT=/home/blackthorne/Work/automation-clockify-sync/state/collector-checkpoints
