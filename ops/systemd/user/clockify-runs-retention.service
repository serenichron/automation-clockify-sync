[Unit]
Description=Clockify unreferenced run retention (dry-run by default)

[Service]
Type=oneshot
WorkingDirectory=/
Environment=PYTHONUNBUFFERED=1 CLOCKIFY_AUTOPILOT_ROOT=%h/Work/automation-clockify-sync-releases/REPLACE_WITH_GIT_SHA
EnvironmentFile=%h/.config/serenichron/clockify-review-cycle-override.env
ExecStart=/usr/bin/python3 ${CLOCKIFY_AUTOPILOT_ROOT}/ops/systemd/user/clockify_runs_retention.py --config %h/.config/serenichron/clockify-runs-retention.json --release ${CLOCKIFY_AUTOPILOT_ROOT}
Restart=no
KillMode=control-group
TimeoutStartSec=1800
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Work/automation-clockify-sync/runs
ReadWritePaths=%h/Work/automation-clockify-sync/state
StandardOutput=journal
StandardError=journal
SyslogIdentifier=clockify-runs-retention
