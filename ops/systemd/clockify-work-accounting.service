[Unit]
Description=Clockify evidence-grounded scheduled review
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/Work/automation-clockify-sync
EnvironmentFile=%h/.config/serenichron/clockify-work-accounting.env
# Optional protected OpenAI-compatible Precision gateway client. The analyzer
# consumes OPENAI_* plus the Cloudflare Access service credential pair without
# copying secrets into the Clockify-specific environment file.
EnvironmentFile=-%h/.config/serenichron/precision-inference-client.env
# Optional final non-secret host overrides (URL, paths, range, retry count).
# Kept separate so the credential-bearing files never need rewriting.
EnvironmentFile=-%h/.config/serenichron/clockify-work-accounting-override.env
Environment=PYTHONUNBUFFERED=1
UnsetEnvironment=CLOCKIFY_ANALYZER_FALLBACK_URL CLOCKIFY_ANALYZER_FALLBACK_MODEL CLOCKIFY_ANALYZER_FALLBACK_API_KEY CLOCKIFY_ANALYZER_FALLBACK_TIMEOUT_SECONDS CLOCKIFY_ANALYZER_FALLBACK_REVISION
ExecStart=/usr/bin/python3 scripts/clockify_autopilot_runner.py
Restart=on-failure
RestartPreventExitStatus=2
# Exit 75 means source coverage was incomplete. Recollect after peers have had
# time to reconnect; the runner bounds retries before the next normal schedule.
RestartSec=3600
KillMode=control-group
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Work/automation-clockify-sync/runs
ReadWritePaths=%h/Work/automation-clockify-sync/state
StandardOutput=journal
StandardError=journal
SyslogIdentifier=clockify-work-accounting

[Install]
WantedBy=default.target
