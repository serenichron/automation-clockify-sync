# Copy to ~/.config/serenichron/clockify-work-accounting.env with mode 0600.
# Never commit credentials. The live file must also define the approved pinned
# CLOCKIFY_ANALYZER_PRIMARY_* route and private-text approval variables.
# On Precision, the optional precision-inference-client.env supplies OPENAI_*
# and CF_ACCESS_* credentials. Keep this file free of duplicate secret values.
CLOCKIFY_ANALYZER_PRIMARY_URL=http://127.0.0.1:11434/v1/chat/completions
CLOCKIFY_ANALYZER_PRIMARY_MODEL=deepseek-v4-flash:cloud
# Resolve the current 64-character digest with `ollama show` before each run.
CLOCKIFY_ANALYZER_PRIMARY_REVISION=
# Ollama's default thinking mode can spend minutes on contract-sized prompts.
# `none` keeps Flash inference semantic while disabling the unbounded reasoning
# stream. The selected value is bound to new cache decisions; legacy sealed
# decisions from the same model and revision remain replayable.
CLOCKIFY_ANALYZER_PRIMARY_REASONING_EFFORT=none
# Month-scale cloud responses can legitimately exceed the library's 120s
# default.  A longer single attempt avoids repeatedly paying for cancelled
# Flash inference while the append-only cache preserves completed decisions.
CLOCKIFY_ANALYZER_PRIMARY_TIMEOUT_SECONDS=600
# Read-only Clockify collection timeout; valid range is 5 through 120 seconds.
CLOCKIFY_HTTP_TIMEOUT_SECONDS=30
# Set to approved only for a specifically authorized private semantic run.
CLOCKIFY_ANALYZER_PRIVATE_TEXT_APPROVED=
CLOCKIFY_ACCOUNTING_ROOT=/home/blackthorne/Work/automation-clockify-sync
CLOCKIFY_ACCOUNTING_RUN_DIR=/home/blackthorne/Work/automation-clockify-sync/runs/20260808T142947Z
CLOCKIFY_ACCOUNTING_CACHE=/home/blackthorne/Work/automation-clockify-sync/state/validation/august-through-20260808/analyzer-cache-v2.jsonl
CLOCKIFY_ACCOUNTING_STATUS=/home/blackthorne/Work/automation-clockify-sync/state/validation/august-through-20260808/runner-status.json
CLOCKIFY_ACCOUNTING_LOCK=/home/blackthorne/Work/automation-clockify-sync/state/validation/august-through-20260808/runner.lock
# The protected Precision path terminates responses that exceed roughly 125s.
# Keep semantic requests small enough to complete before that boundary instead
# of paying for an oversized request and its later recovery partitions.
CLOCKIFY_ACCOUNTING_TARGET_BODY_BYTES=75000
CLOCKIFY_ACCOUNTING_MAX_EVENTS=250
CLOCKIFY_ACCOUNTING_WORKERS=4

# Persistent scheduled review. Leave SINCE/UNTIL empty for the collector's
# rolling window; set both only for an explicitly approved bounded backfill.
CLOCKIFY_AUTOPILOT_ROOT=/home/blackthorne/Work/automation-clockify-sync
CLOCKIFY_AUTOPILOT_STATUS=/home/blackthorne/Work/automation-clockify-sync/state/autopilot-runner-status.json
CLOCKIFY_AUTOPILOT_LOCK=/home/blackthorne/Work/automation-clockify-sync/state/autopilot-runner.lock
CLOCKIFY_AUTOPILOT_COVERAGE_STATE=/home/blackthorne/Work/automation-clockify-sync/state/source-coverage.json
CLOCKIFY_AUTOPILOT_CACHE=/home/blackthorne/Work/automation-clockify-sync/state/analyzer-cache-v2.jsonl
CLOCKIFY_AUTOPILOT_STATE=/home/blackthorne/Work/automation-clockify-sync/state/review-items.json
CLOCKIFY_AUTOPILOT_CORRECTIONS=/home/blackthorne/Work/automation-clockify-sync/state/review-corrections.jsonl
CLOCKIFY_AUTOPILOT_MAX_COVERAGE_RETRIES=2
CLOCKIFY_AUTOPILOT_COORDINATOR=omarchy-precision
CLOCKIFY_AUTOPILOT_ANALYZER_TARGET_BODY_BYTES=75000
CLOCKIFY_AUTOPILOT_ANALYZER_MAX_EVENTS=250
CLOCKIFY_AUTOPILOT_ANALYZER_WORKERS=8
CLOCKIFY_AUTOPILOT_SINCE=
CLOCKIFY_AUTOPILOT_UNTIL=
