# Copy to ~/.config/serenichron/clockify-work-accounting.env with mode 0600.
# Never commit credentials. The live file must also define the approved pinned
# CLOCKIFY_ANALYZER_PRIMARY_* route and private-text approval variables.
CLOCKIFY_ANALYZER_PRIMARY_URL=http://127.0.0.1:11434/v1/chat/completions
CLOCKIFY_ANALYZER_PRIMARY_MODEL=deepseek-v4-flash:0731-cloud
# Resolve the current 64-character digest with `ollama show` before each run.
CLOCKIFY_ANALYZER_PRIMARY_REVISION=
# Set to approved only for a specifically authorized private semantic run.
CLOCKIFY_ANALYZER_PRIVATE_TEXT_APPROVED=
CLOCKIFY_ACCOUNTING_ROOT=/home/blackthorne/Work/serenichron/automation/clockify-sync
CLOCKIFY_ACCOUNTING_RUN_DIR=/home/blackthorne/Work/serenichron/automation/clockify-sync/runs/20260804T112752Z
CLOCKIFY_ACCOUNTING_CACHE=/home/blackthorne/Work/serenichron/automation/clockify-sync/state/validation/july-through-20260804-89b7a87-flash-6ca9e29c-shadow-1/analyzer-cache-v2.jsonl
CLOCKIFY_ACCOUNTING_STATUS=/home/blackthorne/Work/serenichron/automation/clockify-sync/state/validation/july-through-20260804-89b7a87-flash-6ca9e29c-shadow-1/runner-status.json
CLOCKIFY_ACCOUNTING_LOCK=/home/blackthorne/Work/serenichron/automation/clockify-sync/state/validation/july-through-20260804-89b7a87-flash-6ca9e29c-shadow-1/runner.lock
CLOCKIFY_ACCOUNTING_TARGET_BODY_BYTES=250000
CLOCKIFY_ACCOUNTING_MAX_EVENTS=250
CLOCKIFY_ACCOUNTING_WORKERS=4
