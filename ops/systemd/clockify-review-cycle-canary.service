[Unit]
Description=Clockify review-cycle release canary (plan only)

[Service]
Type=oneshot
User=blackthorne
Group=blackthorne
WorkingDirectory=/
Environment=PYTHONUNBUFFERED=1 GOOGLE_WORKSPACE_CLI_CONFIG_DIR=/var/lib/serenichron/clockify-review-cycle/gws CLOCKIFY_AUTOPILOT_ROOT=/home/blackthorne/Work/automation-clockify-sync-releases/REPLACE_WITH_GIT_SHA CLOCKIFY_REVIEW_CYCLE_CONFIG=/etc/serenichron/clockify-review-cycle.json
EnvironmentFile=/etc/serenichron/clockify-review-cycle.env
EnvironmentFile=-/etc/serenichron/clockify-review-cycle-override.env
UnsetEnvironment=CLOCKIFY_ANALYZER_FALLBACK_URL CLOCKIFY_ANALYZER_FALLBACK_MODEL CLOCKIFY_ANALYZER_FALLBACK_API_KEY CLOCKIFY_ANALYZER_FALLBACK_TIMEOUT_SECONDS CLOCKIFY_ANALYZER_FALLBACK_REVISION
ExecStart=/usr/bin/python3 ${CLOCKIFY_AUTOPILOT_ROOT}/scripts/clockify_review_cycle.py --config ${CLOCKIFY_REVIEW_CYCLE_CONFIG}
Restart=no
KillMode=control-group
TimeoutStartSec=300
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/blackthorne/Work/automation-clockify-sync/runs /home/blackthorne/Work/automation-clockify-sync/state /var/lib/serenichron/clockify-review-cycle/gws
StandardOutput=journal
StandardError=journal
SyslogIdentifier=clockify-review-cycle-canary
