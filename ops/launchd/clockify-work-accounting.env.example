# Copy to ~/.config/serenichron/clockify-work-accounting.env with mode 0600.
# Never commit credentials. Fill the exact approved run, cache, model revision,
# and private-text authorization before loading the launch agent.
CLOCKIFY_ANALYZER_PRIMARY_URL=http://127.0.0.1:11434/v1/chat/completions
CLOCKIFY_ANALYZER_PRIMARY_MODEL=deepseek-v4-flash:cloud
CLOCKIFY_ANALYZER_PRIMARY_REVISION=
CLOCKIFY_ANALYZER_PRIMARY_TIMEOUT_SECONDS=600
CLOCKIFY_ANALYZER_PRIVATE_TEXT_APPROVED=
CLOCKIFY_ACCOUNTING_ROOT=/Users/blackthorne/Work/automation-clockify-sync
CLOCKIFY_ACCOUNTING_RUN_DIR=/Users/blackthorne/Work/automation-clockify-sync/runs/<run-id>
CLOCKIFY_ACCOUNTING_CACHE=/Users/blackthorne/Work/automation-clockify-sync/state/validation/<period>/analyzer-cache.jsonl
CLOCKIFY_ACCOUNTING_STATUS=/Users/blackthorne/Work/automation-clockify-sync/state/validation/<period>/runner-status.json
CLOCKIFY_ACCOUNTING_LOCK=/Users/blackthorne/Work/automation-clockify-sync/state/validation/<period>/runner.lock
# The protected Precision path terminates responses that exceed roughly 125s.
# Start below that observed boundary to avoid oversized-request recovery waste.
CLOCKIFY_ACCOUNTING_TARGET_BODY_BYTES=75000
CLOCKIFY_ACCOUNTING_MAX_EVENTS=250
CLOCKIFY_ACCOUNTING_WORKERS=4
