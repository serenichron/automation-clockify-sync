{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-analysis-v1.json",
  "title": "Clockify semantic analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_version",
    "evidence_bundle_schema_version",
    "evidence_bundle_manifest",
    "ledger_event_count",
    "ledger_evidence_digest",
    "activities",
    "exceptions",
    "omissions",
    "analysis_chunks",
    "analyzer_cache"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "prompt_version": {"const": "clockify-semantic-v11"},
    "evidence_bundle_schema_version": {"const": "clockify-semantic-evidence-bundle/v1"},
    "evidence_bundle_manifest": {"$ref": "#/$defs/evidenceBundleManifest"},
    "ledger_event_count": {"type": "integer", "minimum": 0},
    "ledger_evidence_digest": {"type": "string", "pattern": "^led-[a-f0-9]{24}$"},
    "activities": {"type": "array", "items": {"$ref": "#/$defs/activity"}},
    "exceptions": {"type": "array", "items": {"$ref": "#/$defs/nonactivity"}},
    "omissions": {"type": "array", "items": {"$ref": "#/$defs/nonactivity"}},
    "analysis_chunks": {"type": "array", "items": {"$ref": "#/$defs/chunk"}},
    "analyzer_cache": {"$ref": "#/$defs/analyzerCache"},
    "noise_classifications": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^ev-[a-f0-9]{64}$"}
    },
    "effort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_minutes", "recommended_minutes", "maximum_minutes"],
      "properties": {
        "minimum_minutes": {"type": "integer", "minimum": 1},
        "recommended_minutes": {"type": "integer", "minimum": 1},
        "maximum_minutes": {"type": "integer", "minimum": 1}
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"lifecycle": {"not": {"enum": ["planned", "noise"]}}},
            "required": ["lifecycle"]
          },
          "then": {
            "properties": {"split_rationale": {"type": "string", "minLength": 1}}
          }
        }
      ],
      "required": [
        "activity_id", "workstream_id", "workstream", "lifecycle", "action", "object", "outcome",
        "evidence_ids", "evidence_spans", "project_recommendation", "effort",
        "semantic_confidence", "timing_confidence", "split_rationale", "merge_rationale",
        "omit_rationale", "rendered_description", "analyzer_model", "analyzer_tier",
        "prompt_version", "schema_version"
      ],
      "properties": {
        "activity_id": {"type": "string", "pattern": "^act-[a-f0-9]{24}$"},
        "workstream_id": {"type": "string", "pattern": "^ws-[a-f0-9]{24}$"},
        "workstream": {"type": "string", "minLength": 1},
        "lifecycle": {"enum": ["completed", "advanced", "investigated", "meeting", "planned", "blocked", "noise"]},
        "action": {"type": "string"},
        "object": {"type": "string"},
        "outcome": {"type": "string"},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"},
        "evidence_spans": {"type": "array", "items": {"type": "object"}},
        "project_recommendation": {"type": "object"},
        "effort": {"$ref": "#/$defs/effort"},
        "semantic_confidence": {"enum": ["low", "medium", "high"]},
        "timing_confidence": {"enum": ["low", "medium", "high"]},
        "split_rationale": {"type": "string"},
        "merge_rationale": {"type": "string"},
        "omit_rationale": {"type": "string"},
        "rendered_description": {"type": ["string", "null"]},
        "analyzer_model": {"type": "string"},
        "analyzer_tier": {"enum": ["primary", "fallback", "fixture"]},
        "prompt_version": {"const": "clockify-semantic-v11"},
        "schema_version": {"const": 1}
      }
    },
    "nonactivity": {
      "type": "object",
      "required": ["evidence_ids", "reason"],
      "properties": {
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"},
        "reason": {"type": "string"}
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk", "event_count", "evidence_digest", "endpoint", "evidence_bundle_schema_version", "bundle_count", "bundle_manifest_digest"],
      "allOf": [
        {
          "oneOf": [
            {
              "required": ["model", "tier", "fallback_status"],
              "not": {"anyOf": [{"required": ["recovery_status"]}, {"required": ["recovery"]}]}
            },
            {
              "required": ["partition_path", "partition_depth", "repair_status", "recovery_status", "recovery"],
              "not": {"anyOf": [{"required": ["model"]}, {"required": ["tier"]}, {"required": ["fallback_status"]}]}
            }
          ]
        },
        {
          "if": {"properties": {"tier": {"const": "exception"}}, "required": ["tier"]},
          "then": {
            "required": ["failure_digest", "fallback_endpoint", "fallback_model"],
            "properties": {"fallback_status": {"const": "failed_exception"}}
          },
          "else": {"not": {"required": ["failure_digest"]}}
        },
        {
          "if": {"properties": {"fallback_status": {"const": "failed_exception"}}, "required": ["fallback_status"]},
          "then": {"properties": {"tier": {"const": "exception"}}}
        },
        {
          "if": {
            "properties": {
              "recovery": {
                "properties": {"status": {"const": "recovered"}},
                "required": ["status"]
              }
            },
            "required": ["recovery"]
          },
          "then": {"properties": {"recovery_status": {"const": "recovered_by_partition"}}}
        },
        {
          "if": {
            "properties": {
              "recovery": {
                "properties": {"status": {"const": "exhausted"}},
                "required": ["status"]
              }
            },
            "required": ["recovery"]
          },
          "then": {"properties": {"recovery_status": {"const": "partition_exception"}}}
        }
      ],
      "properties": {
        "chunk": {"type": "integer", "minimum": 1},
        "event_count": {"type": "integer", "minimum": 1},
        "evidence_digest": {"type": "string", "pattern": "^ech-[a-f0-9]{24}$"},
        "endpoint": {"type": "string"},
        "model": {"type": "string"},
        "tier": {"enum": ["primary", "fallback", "exception"]},
        "partition_path": {"type": "string", "pattern": "^root(?:\\.[ab])*$"},
        "partition_depth": {"type": "integer", "minimum": 0, "maximum": 8},
        "recovery_status": {"enum": ["recovered_by_partition", "partition_exception"]},
        "recovery": {"$ref": "#/$defs/recovery"},
        "fallback_status": {
          "enum": [
            "not_needed",
            "used_after_primary_failure",
            "used_for_low_confidence",
            "failed_deferred",
            "failed_exception"
          ]
        },
        "repair_status": {
          "enum": ["not_attempted", "used", "rejected", "transport_failed", "partitioned"]
        },
        "failure_digest": {"type": "string", "pattern": "^aer-[a-f0-9]{24}$"},
        "fallback_endpoint": {"type": "string", "minLength": 1},
        "fallback_model": {"type": "string", "minLength": 1},
        "evidence_bundle_schema_version": {"const": "clockify-semantic-evidence-bundle/v1"},
        "bundle_count": {"type": "integer", "minimum": 1},
        "bundle_manifest_digest": {"type": "string", "pattern": "^sebm-[a-f0-9]{64}$"}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "path", "depth", "max_depth", "split_at_event", "parent_failure_digest", "children"],
      "properties": {
        "status": {"enum": ["recovered", "exhausted"]},
        "path": {"type": "string", "pattern": "^root(?:\\.[ab])*$"},
        "depth": {"type": "integer", "minimum": 0, "maximum": 8},
        "max_depth": {"const": 8},
        "split_at_event": {"type": "integer", "minimum": 1},
        "parent_failure_digest": {"type": "string", "pattern": "^aer-[a-f0-9]{24}$"},
        "children": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/chunk"}
        }
      }
    },
    "evidenceBundleManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "digest", "bundles"],
      "properties": {
        "schema_version": {"const": "clockify-semantic-evidence-bundle/v1"},
        "digest": {"type": "string", "pattern": "^sebm-[a-f0-9]{64}$"},
        "bundles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["bundle_id", "bundle_ref", "context_digest", "projected_digest", "member_count", "evidence_ids"],
            "properties": {
              "chunk": {"type": "integer", "minimum": 1},
              "bundle_id": {"type": "string", "pattern": "^seb-[a-f0-9]{64}$"},
              "bundle_ref": {"type": "string", "pattern": "^b-[0-9]{4}$"},
              "context_digest": {"type": "string", "pattern": "^sec-[a-f0-9]{64}$"},
              "projected_digest": {"type": "string", "pattern": "^sep-[a-f0-9]{64}$"},
              "member_count": {"type": "integer", "minimum": 1},
              "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "analyzerCache": {
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["schema_version", "status"],
          "properties": {
            "schema_version": {"const": "clockify-analyzer-cache/v2"},
            "status": {"const": "disabled"}
          }
        },
        {
          "additionalProperties": false,
          "required": ["schema_version", "hits", "misses", "records"],
          "properties": {
            "schema_version": {"const": "clockify-analyzer-cache/v2"},
            "hits": {"type": "integer", "minimum": 0},
            "misses": {"type": "integer", "minimum": 0},
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["cache_key", "decision_digest"],
                "properties": {
                  "cache_key": {"type": "string", "pattern": "^arc-[a-f0-9]{64}$"},
                  "decision_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
                }
              }
            }
          }
        }
      ]
    }
  }
}
