{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-accounting-result-v1.json",
  "title": "Clockify work accounting result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "allocation_mode", "ledger_manifest", "semantic_analysis",
    "proposals", "ambiguous", "skipped", "review_tombstones", "allocation", "fathom_reconciliation",
    "correction_regression", "external_writes", "member_identities", "coverage_warnings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "allocation_mode": {"const": "non_overlapping_v1"},
    "ledger_manifest": {"type": "object"},
    "member_identities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "semantic_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_version", "activity_count", "exception_count", "omission_count", "noise_count", "learning_case_count"],
      "properties": {
        "prompt_version": {"type": ["string", "null"]},
        "activity_count": {"type": "integer", "minimum": 0},
        "exception_count": {"type": "integer", "minimum": 0},
        "omission_count": {"type": "integer", "minimum": 0},
        "noise_count": {"type": "integer", "minimum": 0},
        "learning_case_count": {"type": "integer", "minimum": 0}
      }
    },
    "proposals": {"type": "array", "items": {"$ref": "#/$defs/proposal"}},
    "ambiguous": {"type": "array", "items": {"type": "object"}},
    "skipped": {"type": "array", "items": {"type": "object"}},
    "review_tombstones": {"type": "array", "items": {"type": "object"}},
    "allocation": {"type": "object"},
    "fathom_reconciliation": {"type": "array", "items": {"type": "object"}},
    "meeting_reconciliation_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "meeting_dedup_version": {"type": "string", "minLength": 1},
    "meeting_dedup_tolerance_seconds": {"type": "integer", "minimum": 0},
    "meeting_split_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "correction_regression": {"$ref": "#/$defs/correctionRegression"},
    "coverage_warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "reason"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "external_writes": {"const": false}
  },
  "allOf": [{
    "if": {
      "anyOf": [
        {"required": ["meeting_reconciliation_digest"]},
        {"required": ["meeting_dedup_version"]},
        {"required": ["meeting_dedup_tolerance_seconds"]},
        {"required": ["meeting_split_digest"]}
      ]
    },
    "then": {
      "required": [
        "meeting_reconciliation_digest",
        "meeting_dedup_version",
        "meeting_dedup_tolerance_seconds",
        "meeting_split_digest"
      ]
    }
  }],
  "$defs": {
    "correctionRegression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "results", "summary"],
      "properties": {
        "schema_version": {"const": 1},
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "regression_case_id", "activity_id", "evidence_fingerprint",
              "decision", "status", "failures"
            ],
            "properties": {
              "regression_case_id": {"type": "string", "pattern": "^rcase-[a-f0-9]{24}$"},
              "activity_id": {"type": "string", "pattern": "^act-[a-f0-9]{24}$"},
              "evidence_fingerprint": {"type": "string", "pattern": "^evfp:sha256:[a-f0-9]{64}$"},
              "decision": {"enum": ["approve", "skip", "modify"]},
              "status": {"enum": ["pass", "fail", "not_applicable"]},
              "failures": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pass", "fail", "not_applicable"],
          "properties": {
            "pass": {"type": "integer", "minimum": 0},
            "fail": {"type": "integer", "minimum": 0},
            "not_applicable": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "proposal": {
      "type": "object",
      "required": [
        "id", "candidate_key", "review_activity_key", "allocation_segment",
        "activity_id", "workstream_id", "start", "end",
        "duration_minutes", "duration_seconds", "client_project", "description", "source", "allocation_mode",
        "rendered_description", "effort", "provenance"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^P[0-9]{3,}$"},
        "candidate_key": {"type": "string", "pattern": "^wks-[a-f0-9]{24}$"},
        "review_activity_key": {"type": "string", "pattern": "^wka-[a-f0-9]{24}$"},
        "allocation_segment": {"type": "integer", "minimum": 1},
        "activity_id": {"type": "string", "pattern": "^act-[a-f0-9]{24}$"},
        "workstream_id": {"type": "string", "pattern": "^ws-[a-f0-9]{24}$"},
        "start": {"type": "string"},
        "end": {"type": "string"},
        "duration_minutes": {"type": "integer", "minimum": 0},
        "duration_seconds": {"type": "integer", "minimum": 1},
        "client_project": {"type": "string"},
        "clockify_project_suffix": {"type": ["string", "null"]},
        "tag_suffixes": {"type": "array", "items": {"type": "string"}},
        "tag_names": {"type": "array", "items": {"type": "string"}},
        "billable": {"type": "boolean"},
        "routing_disposition": {"enum": ["unresolved-routing"]},
        "review_warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "if": {
              "required": ["type"],
              "properties": {"type": {"const": "unresolved_routing"}}
            },
            "then": {"$ref": "#/$defs/unresolvedRoutingWarning"}
          }
        },
        "description": {"type": "string", "minLength": 1},
        "rendered_description": {"type": "string", "minLength": 1},
        "source": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^evidence:ev-[a-f0-9]{64}$"}},
        "allocation_mode": {"const": "non_overlapping_v1"},
        "effort": {"type": "object"},
        "provenance": {"type": "object"}
      },
      "allOf": [{
        "if": {
          "required": ["routing_disposition"],
          "properties": {"routing_disposition": {"const": "unresolved-routing"}}
        },
        "then": {
          "required": [
            "client_project", "clockify_project_suffix", "tag_suffixes",
            "tag_names", "billable", "routing_disposition", "review_warnings"
          ],
          "properties": {
            "client_project": {"const": ""},
            "clockify_project_suffix": {"const": ""},
            "tag_suffixes": {"const": []},
            "tag_names": {"const": []},
            "billable": {"const": false},
            "review_warnings": {
              "type": "array",
              "contains": {"$ref": "#/$defs/unresolvedRoutingWarning"},
              "minContains": 1,
              "maxContains": 1
            }
          }
        },
        "else": {
          "properties": {"client_project": {"minLength": 1}}
        }
      }]
    },
    "unresolvedRoutingWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "disposition", "reason_code"],
      "properties": {
        "type": {"const": "unresolved_routing"},
        "disposition": {"const": "unresolved-routing"},
        "reason_code": {"const": "no_deterministic_route"}
      }
    }
  }
}
