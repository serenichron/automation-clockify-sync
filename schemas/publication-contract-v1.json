{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "publication-contract-v1.json",
  "title": "Clockify finance publication contract v1",
  "oneOf": [
    {"$ref": "#/$defs/prepared"},
    {"$ref": "#/$defs/authorized"}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "amounts": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Z]{3}$"},
      "additionalProperties": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"}
    },
    "quote": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "provider", "effective_date", "fetched_at", "base_currency", "rates", "payload_digest"],
      "properties": {
        "schema_version": {"const": "fx-quote-receipt/v1"}, "provider": {"const": "ECB"},
        "effective_date": {"type": "string", "format": "date"}, "fetched_at": {"type": "string", "format": "date-time"},
        "base_currency": {"const": "EUR"}, "rates": {"$ref": "#/$defs/amounts"}, "payload_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "prepared": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "state", "period_id", "workspace_id", "member_id", "timezone", "period_start", "period_end", "revision",
        "manifest_digest", "event_history_digest", "post_receipt_digest", "clockify_readback_digest", "duration_seconds",
        "native_buckets", "usd_buckets", "usd_equivalent_total", "fx_quote", "report_target", "slack_target", "idempotency_key", "contract_digest"
      ],
      "properties": {
        "schema_version": {"const": "publication-contract/v1"}, "state": {"const": "publication_prepared"},
        "period_id": {"type": "string", "minLength": 1}, "workspace_id": {"type": "string", "minLength": 1}, "member_id": {"type": "string", "minLength": 1},
        "timezone": {"type": "string", "minLength": 1}, "period_start": {"type": "string", "format": "date-time"}, "period_end": {"type": "string", "format": "date-time"}, "revision": {"type": "integer", "minimum": 1},
        "manifest_digest": {"$ref": "#/$defs/digest"}, "event_history_digest": {"$ref": "#/$defs/digest"}, "post_receipt_digest": {"$ref": "#/$defs/digest"}, "clockify_readback_digest": {"$ref": "#/$defs/digest"},
        "duration_seconds": {"type": "integer", "minimum": 0}, "native_buckets": {"$ref": "#/$defs/amounts"}, "usd_buckets": {"$ref": "#/$defs/amounts"}, "usd_equivalent_total": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{2})?$"},
        "fx_quote": {"$ref": "#/$defs/quote"}, "report_target": {"type": "string", "minLength": 1}, "slack_target": {"type": "string", "minLength": 1}, "idempotency_key": {"type": "string", "minLength": 1}, "contract_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "authorized": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "state", "contract", "contract_digest", "approval_id", "approval_digest", "approver", "expires_at", "operations", "idempotency_key", "authorization_digest"],
      "properties": {
        "schema_version": {"const": "publication-contract/v1"}, "state": {"const": "publication_authorized"}, "contract": {"$ref": "#/$defs/prepared"},
        "contract_digest": {"$ref": "#/$defs/digest"}, "approval_id": {"type": "string", "minLength": 1}, "approval_digest": {"$ref": "#/$defs/digest"}, "approver": {"type": "string", "minLength": 1}, "expires_at": {"type": "string", "format": "date-time"},
        "operations": {"const": ["shared_report_update", "slack_correction"]}, "idempotency_key": {"type": "string", "minLength": 1}, "authorization_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
