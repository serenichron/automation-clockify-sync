{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-ledger-v1.json",
  "title": "Clockify evidence ledger v1",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/ledgerDocument"},
    {"$ref": "#/$defs/event"},
    {"$ref": "#/$defs/manifest"}
  ],
  "$defs": {
    "jsonObject": {"type": "object", "additionalProperties": true},
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "evidence_id", "source_type", "source_ref", "raw_source_span", "attributes", "legacy_aliases"],
      "properties": {
        "schema_version": {"const": "evidence-ledger/v1"},
        "evidence_id": {"type": "string", "pattern": "^ev-[a-f0-9]{64}$"},
        "source_type": {"type": "string", "minLength": 1},
        "source_ref": {"$ref": "#/$defs/jsonObject", "minProperties": 1},
        "observed_at": {"type": ["string", "null"]},
        "raw_source_span": {"$ref": "#/$defs/jsonObject"},
        "attributes": {"$ref": "#/$defs/jsonObject"},
        "legacy_aliases": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {
            "properties": {"source_type": {"const": "calendly"}},
            "required": ["source_type"]
          },
          "then": {
            "required": ["observed_at"],
            "properties": {
              "observed_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
              "source_ref": {"$ref": "#/$defs/calendlySourceRef"},
              "raw_source_span": {"$ref": "#/$defs/calendlySourceSpan"},
              "attributes": {"$ref": "#/$defs/calendlyAttributes"}
            }
          }
        }
      ]
    },
    "ledgerDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "manifest", "events"],
      "properties": {
        "schema_version": {"const": "evidence-ledger/v1"},
        "manifest": {"$ref": "#/$defs/manifest"},
        "events": {
          "type": "array",
          "items": {"$ref": "#/$defs/event"}
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "manifest_id", "events_digest", "event_count", "source_inventory", "source_completeness"],
      "properties": {
        "schema_version": {"const": "evidence-ledger/v1"},
        "manifest_id": {"type": "string", "pattern": "^elm-[a-f0-9]{64}$"},
        "events_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "event_count": {"type": "integer", "minimum": 0},
        "source_inventory": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sourceStatus"}},
        "timezone": {"type": "string", "minLength": 1},
        "member_identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_completeness": {"type": "object"}
      }
    },
    "sourceStatus": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["complete", "partial", "unavailable", "excluded"]},
        "expected_count": {"type": "integer", "minimum": 0},
        "observed_count": {"type": "integer", "minimum": 0},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "calendlyAttributes": {
      "type": "object",
      "required": [
        "recording_id", "meeting_id", "title", "duration_seconds", "organizer",
        "participants", "join_url", "transcript", "summary", "source_digest"
      ],
      "properties": {
        "recording_id": {"type": "string", "minLength": 1},
        "meeting_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "duration_seconds": {"type": "integer", "minimum": 1},
        "organizer": {"$ref": "#/$defs/calendlyPerson"},
        "participants": {"type": "array", "items": {"$ref": "#/$defs/calendlyParticipant"}},
        "join_url": {"type": "string"},
        "summary": {"type": "string"},
        "transcript": {"type": "array", "items": {"$ref": "#/$defs/calendlyTranscriptItem"}},
        "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "calendlySourceRef": {
      "type": "object",
      "required": ["source_type", "source_id", "meeting_id"],
      "properties": {
        "source_type": {"const": "calendly"},
        "source_id": {"type": "string", "minLength": 1},
        "meeting_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "calendlySourceSpan": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "end": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      },
      "additionalProperties": false
    },
    "calendlyPerson": {
      "type": "object",
      "properties": {
        "email": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "calendlyParticipant": {
      "allOf": [
        {"$ref": "#/$defs/calendlyPerson"},
        {"minProperties": 1}
      ]
    },
    "calendlyTranscriptItem": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "offset_seconds": {"type": "integer", "minimum": 0},
        "text": {"type": "string"},
        "speaker": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
