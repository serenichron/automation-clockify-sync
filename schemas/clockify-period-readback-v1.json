{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clockify-period-readback-v1.json",
  "title": "Clockify full-period readback v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_kind", "workspace_id", "member_id", "timezone",
    "period_start", "period_end", "filters", "refreshed_at",
    "include_running", "include_deleted", "entry_ids", "entry_count",
    "duration_seconds", "entry_durations", "native_costs", "final_live_readback_sha256", "digest"
  ],
  "properties": {
    "schema_version": {"const": "clockify-period-readback/v1"},
    "evidence_kind": {"enum": ["ledger", "report"]},
    "workspace_id": {"type": "string", "minLength": 1},
    "member_id": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "minLength": 1},
    "period_start": {"type": "string", "format": "date-time"},
    "period_end": {"type": "string", "format": "date-time"},
    "filters": {"type": "object"},
    "refreshed_at": {"type": "string", "format": "date-time"},
    "include_running": {"type": "boolean"},
    "include_deleted": {"type": "boolean"},
    "entry_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "entry_count": {"type": "integer", "minimum": 0},
    "duration_seconds": {"type": "integer", "minimum": 0},
    "entry_durations": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "native_costs": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Z]{3}$"},
      "additionalProperties": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"}
    },
    "final_live_readback_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "request_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "member_id", "period_start", "period_end", "filters", "shared_report_id", "raw_response_digest"],
      "properties": {
        "workspace_id": {"type": "string", "minLength": 1},
        "member_id": {"type": "string", "minLength": 1},
        "period_start": {"type": "string", "format": "date-time"},
        "period_end": {"type": "string", "format": "date-time"},
        "filters": {"type": "object"},
        "shared_report_id": {"type": "string", "minLength": 1},
        "raw_response_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
    ,"raw_response": {
      "type": "object", "additionalProperties": false, "required": ["totals"],
      "properties": {"totals": {"type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["entriesCount", "totalTime", "amounts"],
        "properties": {
          "entriesCount": {"type": "integer", "minimum": 0},
          "totalTime": {"type": "integer", "minimum": 0},
          "amounts": {"type": "array", "minItems": 1, "items": {
            "type": "object", "additionalProperties": false, "required": ["amountByCurrency"],
            "properties": {"amountByCurrency": {"type": "array", "minItems": 1, "items": {
              "type": "object", "additionalProperties": false, "required": ["currency", "amount"],
              "properties": {"currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "amount": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"}}
            }}}
          }}
        }
      }}}
    }
  },
  "allOf": [{
    "if": {"properties": {"evidence_kind": {"const": "report"}}},
    "then": {"required": ["request_receipt", "raw_response"]}
  }]
}
