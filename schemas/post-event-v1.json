{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "post-event-v1.json",
  "title": "Clockify post event ledger v1",
  "$defs": {
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["anchor_schema_version", "ledger_schema_version", "sequence", "previous_anchor_digest", "ledger_count", "ledger_head", "anchor_digest"],
      "properties": {
        "anchor_schema_version": {"const": "receipt-ledger-anchor/v1"}, "ledger_schema_version": {"const": "post-event/v1"}, "sequence": {"type": "integer", "minimum": 0},
        "previous_anchor_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}, "ledger_count": {"type": "integer", "minimum": 1},
        "ledger_head": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "anchor_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "sequence", "previous_digest", "event_digest", "disposition", "operation", "operation_identity", "period_id", "workspace_id", "member_id", "review_id", "segment_index", "recorded_at", "clockify_entry_id", "live_readback_digest"],
      "properties": {
        "schema_version": {"const": "post-event/v1"}, "sequence": {"type": "integer", "minimum": 0}, "previous_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}, "event_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "disposition": {"enum": ["planned", "created", "already_existing", "recovered_after_ambiguous_response", "interrupted"]}, "operation": {"type": "string", "minLength": 1}, "operation_identity": {"type": "string", "pattern": "^opid-[a-f0-9]{64}$"},
        "period_id": {"type": "string", "minLength": 1}, "workspace_id": {"type": "string", "minLength": 1}, "member_id": {"type": "string", "minLength": 1}, "review_id": {"type": "string", "minLength": 1}, "segment_index": {"type": "integer", "minimum": 0}, "recorded_at": {"type": "string", "format": "date-time"},
        "clockify_entry_id": {"type": ["string", "null"]}, "live_readback_digest": {"type": ["string", "null"], "pattern": "^sha256:.+$"}
      },
      "allOf": [
        {"if": {"properties": {"disposition": {"enum": ["created", "recovered_after_ambiguous_response"]}}}, "then": {"properties": {"clockify_entry_id": {"type": "string", "minLength": 1}, "live_readback_digest": {"type": "string", "pattern": "^sha256:.+"}}}},
        {"if": {"properties": {"disposition": {"const": "already_existing"}}}, "then": {"properties": {"clockify_entry_id": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"disposition": {"enum": ["planned", "interrupted"]}}}, "then": {"properties": {"clockify_entry_id": {"type": "null"}, "live_readback_digest": {"type": "null"}}}}
      ]
    }
  },
  "oneOf": [{"$ref": "#/$defs/event"}, {"$ref": "#/$defs/anchor"}]
}
