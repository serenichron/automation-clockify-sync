{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reconciliation-manifest-v1.json",
  "title": "Derived reconciliation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "compatibility_version", "period", "state", "event_count", "events_digest", "artifacts", "blockers", "manifest_digest"],
  "properties": {
    "schema_version": {"const": "reconciliation-manifest/v1"},
    "compatibility_version": {"const": "reconciliation-manifest/v1"},
    "period": {"$ref": "#/$defs/period"},
    "state": {"enum": ["collecting", "reconciling", "awaiting_review", "approved", "posting", "verifying", "publication_prepared", "publication_authorized", "published"]},
    "event_count": {"type": "integer", "minimum": 0},
    "events_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "blockers": {"type": "array", "items": {"enum": ["coverage_incomplete", "semantic_exceptions", "awaiting_approval", "post_interrupted", "readback_mismatch", "report_mismatch", "currency_quote_unavailable", "publication_deferred"]}, "uniqueItems": true},
    "manifest_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility_version", "member_id", "workspace_id", "timezone", "since_utc", "until_utc", "revision"],
      "properties": {
        "compatibility_version": {"const": "reconciliation-period/v1"},
        "member_id": {"type": "string", "minLength": 1},
        "workspace_id": {"type": "string", "minLength": 1},
        "timezone": {"type": "string", "minLength": 1},
        "since_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{6})?Z$"},
        "until_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{6})?Z$"},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema_version", "compatibility_version", "digest"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "schema_version": {"type": "string", "minLength": 1},
        "compatibility_version": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
