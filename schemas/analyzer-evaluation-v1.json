{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analyzer-evaluation-v1.json",
  "title": "Clockify analyzer evaluation v1",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/input"},
    {"$ref": "#/$defs/scorecard"}
  ],
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "model", "tier"],
      "properties": {
        "route_id": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "tier": {"enum": ["primary", "fallback"]}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "corpus", "route", "prompt_version", "semantic_schema_version", "cases"],
      "properties": {
        "schema_version": {"const": "clockify-analyzer-evaluation-input/v1"},
        "corpus": {"type": "object"},
        "route": {"$ref": "#/$defs/route"},
        "prompt_version": {"const": "clockify-semantic-v6"},
        "semantic_schema_version": {"const": 1},
        "cases": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    },
    "scorecard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "evaluator_version", "input_corpus_digest", "input_digest",
        "route", "prompt_version", "semantic_schema_version", "case_count", "results",
        "passed", "scorecard_digest"
      ],
      "properties": {
        "schema_version": {"const": "clockify-analyzer-evaluation-scorecard/v1"},
        "evaluator_version": {"const": "clockify-analyzer-evaluator/v3"},
        "input_corpus_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "input_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "route": {"$ref": "#/$defs/route"},
        "prompt_version": {"const": "clockify-semantic-v6"},
        "semantic_schema_version": {"const": 1},
        "case_count": {"type": "integer", "minimum": 1},
        "results": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "passed": {"type": "boolean"},
        "scorecard_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
