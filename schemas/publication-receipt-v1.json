{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "publication-receipt-v1.json",
  "title": "Clockify finance publication receipt v1",
  "oneOf": [
    {"$ref": "#/$defs/shared_report"},
    {"$ref": "#/$defs/slack"},
    {"$ref": "#/$defs/publication"}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{6})?Z$"},
    "currency_buckets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Z]{3}$"},
      "additionalProperties": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"}
    },
    "shared_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "status", "contract_digest", "authorization_digest", "idempotency_identity", "report_target", "readback_digest", "duration_seconds", "native_buckets", "verified_at"],
      "properties": {
        "schema_version": {"const": "publication-receipt/v1"},
        "kind": {"const": "shared_report"},
        "status": {"const": "verified"},
        "contract_digest": {"$ref": "#/$defs/digest"},
        "authorization_digest": {"$ref": "#/$defs/digest"},
        "idempotency_identity": {"type": "string", "minLength": 1},
        "report_target": {"type": "string", "minLength": 1},
        "readback_digest": {"$ref": "#/$defs/digest"},
        "duration_seconds": {"type": "integer", "minimum": 0},
        "native_buckets": {"$ref": "#/$defs/currency_buckets"},
        "verified_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "slack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "status", "contract_digest", "idempotency_identity", "slack_target", "content_digest", "message_id", "verified_at"],
      "properties": {
        "schema_version": {"const": "publication-receipt/v1"},
        "kind": {"const": "slack"},
        "status": {"const": "verified"},
        "contract_digest": {"$ref": "#/$defs/digest"},
        "idempotency_identity": {"type": "string", "minLength": 1},
        "slack_target": {"type": "string", "minLength": 1},
        "content_digest": {"$ref": "#/$defs/digest"},
        "message_id": {"type": "string", "minLength": 1},
        "verified_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "state", "contract_digest", "authorization_digest", "idempotency_identity", "report_receipt", "slack_receipt", "completed_at"],
      "properties": {
        "schema_version": {"const": "publication-receipt/v1"},
        "kind": {"const": "publication"},
        "state": {"const": "published"},
        "contract_digest": {"$ref": "#/$defs/digest"},
        "authorization_digest": {"$ref": "#/$defs/digest"},
        "idempotency_identity": {"type": "string", "minLength": 1},
        "report_receipt": {"$ref": "#/$defs/shared_report"},
        "slack_receipt": {"$ref": "#/$defs/slack"},
        "completed_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
